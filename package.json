{
  "name": "sealform",
  "version": "0.1.0",
  "description": "Webフォームの入力をブラウザ内で耐量子ハイブリッド暗号化する（HPKE + X-Wing）",
  "main": "./dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "node examples/server.mjs"
  },
  "keywords": [
    "encryption",
    "e2ee",
    "forms",
    "hpke",
    "post-quantum",
    "ml-kem",
    "x-wing",
    "privacy"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@hpke/hybridkem-x-wing": "^0.7.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sealform.js": "./dist/sealform.js"
  },
  "bin": {
    "sealform": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  }
}
