{
  "name": "sealform",
  "version": "0.4.0",
  "description": "Webフォームの入力をブラウザ内で耐量子ハイブリッド暗号化する（HPKE + X-Wing）",
  "main": "./dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "node examples/server.mjs",
    "release:build": "node build.mjs --release && tsc -p tsconfig.json --emitDeclarationOnly",
    "build:wordpress": "node scripts/build-wordpress.mjs",
    "prepare": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly"
  },
  "keywords": [
    "encryption",
    "e2ee",
    "forms",
    "hpke",
    "post-quantum",
    "ml-kem",
    "x-wing",
    "privacy"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@hpke/hybridkem-x-wing": "^0.7.0",
    "@noble/hashes": "^2.4.0",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sealform.js": "./dist/sealform.js"
  },
  "bin": {
    "sealform": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/wordpress",
    "!dist/types/**/*.test.d.ts",
    "server/php/sealform.php",
    "server/python/sealform_check.py"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yotatameguchi-boop/sealform.git"
  },
  "homepage": "https://github.com/yotatameguchi-boop/sealform#readme",
  "bugs": {
    "url": "https://github.com/yotatameguchi-boop/sealform/issues"
  }
}
